rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // Helper to check if user is the owner
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Phase 4: Entity Validations
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'calorieGoal', 'waterGoal']) 
        && data.keys().size() == 4
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() <= 100
        && data.calorieGoal is number && data.calorieGoal >= 0 && data.calorieGoal <= 10000
        && data.waterGoal is number && data.waterGoal >= 0 && data.waterGoal <= 20000;
    }

    function isValidLogEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'timestamp', 'type'])
        && data.userId == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.timestamp is number
        && data.type in ['food', 'water']
        // Conditional fields based on type
        && (data.type == 'food' ? (
          data.calories is number && data.calories >= 0
          && data.description is string && data.description.size() <= 500
          && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000000))
          && (!('nutrients' in data) || (
            data.nutrients is map 
            && (!('protein' in data.nutrients) || data.nutrients.protein is number)
            && (!('carbs' in data.nutrients) || data.nutrients.carbs is number)
            && (!('fat' in data.nutrients) || data.nutrients.fat is number)
          ))
        ) : true)
        && (data.type == 'water' ? (
          data.amount is number && data.amount >= 0 && data.amount <= 5000
        ) : true);
    }

    // Match Blocks
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) 
        && incoming().uid == existing().uid; // UID immutable
      allow delete: if false; // Users can't delete their profile via client
    }

    match /logs/{logId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidLogEntry(incoming()) && incoming().userId == request.auth.uid;
      allow update: if false; // Logs are usually immutable, delete and recreate if needed
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
